# Preserve supplied artwork as original files and keep its review as binary.
*.pdf binary
*.eps binary
*.png binary
*.jpg binary
*.jpeg binary
*.tif binary
*.tiff binary
*.ico binary
*.ttf binary
*.zip binary
*.jar binary
# The Windows Gradle launcher retains the line endings required on that platform.
aplicativo/native/android/gradlew.bat text eol=crlf whitespace=cr-at-eol
aplicativo/sync-server/windows/*.cmd text eol=crlf whitespace=cr-at-eol
